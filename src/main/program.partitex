/* ========================================
   PARTITEX COMPILER - SIMPLE EXAMPLE
   ======================================== */

/* Basic musical composition example */
key do4 major;
time 4/4;
tempo allegro;

/* Simple melody */
notes: do4 quarter, re4 quarter, mi4 quarter, fa4 quarter;

/* Pattern definition */
pattern intro: sol4 quarter, la4 quarter, si4 quarter, do5 quarter;

/* Melody with multiple lines */
melody verse: do4 half, re4 quarter, mi4 quarter, fa4 half;

/* Repeat pattern with timing */
repeat intro 2 1 seconds;

/* Simultaneous instruments */
simultaneous:
    instrument piano: do4 whole, mi4 whole, sol4 whole;;
    instrument violin: do5 whole, mi5 whole, sol5 whole
;



